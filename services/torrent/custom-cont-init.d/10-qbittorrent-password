#!/bin/bash
# Nota: init-custom-files invoca este script con `/bin/bash "${SCRIPT}"` y
# ademas necesita el bit +x (via COPY --chmod=755 en el Dockerfile) — el
# shebang de esta linea no lo respeta el runner, es sólo documentación.
#
# Fija WebUI\Username y WebUI\Password_PBKDF2 en qBittorrent.conf a partir de
# QBITTORRENT_USER / QBITTORRENT_PASSWORD, para que la WebUI arranque siempre
# con una password estable en vez de la temporal que genera qBittorrent
# cuando no encuentra la clave. No toca Downloads\SavePath: eso lo maneja la
# tabla Setting del api.

set -euo pipefail

CONF_PATH="/config/qBittorrent/qBittorrent.conf"

if [ -z "${QBITTORRENT_PASSWORD:-}" ]; then
  echo "[10-qbittorrent-password] ERROR: QBITTORRENT_PASSWORD está vacío. No fijo ninguna password: la WebUI quedaría con una temporal que rota en cada arranque. Abortando." >&2
  exit 1
fi

if [ ! -f "${CONF_PATH}" ]; then
  echo "[10-qbittorrent-password] ERROR: no existe ${CONF_PATH} (¿corrió init-qbittorrent-config?)." >&2
  exit 1
fi

QBITTORRENT_USER="${QBITTORRENT_USER:-admin}" \
QBITTORRENT_PASSWORD="${QBITTORRENT_PASSWORD}" \
CONF_PATH="${CONF_PATH}" \
python3 <<'PYEOF'
import base64
import hashlib
import os
import re
import secrets

conf_path = os.environ["CONF_PATH"]
username = os.environ["QBITTORRENT_USER"]
password = os.environ["QBITTORRENT_PASSWORD"]

# Claves de un INI de Qt: llevan backslash y valores @ByteArray(...)/@Variant(...)
# que configparser no sabe parsear. Por eso todo esto es regex línea por línea.
USERNAME_KEY = "WebUI\\Username"
PASSWORD_KEY = "WebUI\\Password_PBKDF2"

ITERATIONS = 100_000
KEY_LENGTH = 64


def pbkdf2(pw: str, salt: bytes) -> bytes:
    return hashlib.pbkdf2_hmac("sha512", pw.encode("utf-8"), salt, ITERATIONS, dklen=KEY_LENGTH)


with open(conf_path, "r") as f:
    lines = f.readlines()


def find_line_index(key: str):
    prefix = key + "="
    for i, line in enumerate(lines):
        if line.startswith(prefix):
            return i
    return None


def get_value(key: str):
    idx = find_line_index(key)
    if idx is None:
        return None
    value = lines[idx].rstrip("\n")[len(key) + 1:]
    # qBittorrent-nox re-serializa sus propios settings al hacer shutdown
    # limpio, y a valores como este (con "@"/paréntesis) los envuelve en
    # comillas dobles literales. Las sacamos antes de comparar, así la
    # idempotencia no depende de si el último en tocar el archivo fuimos
    # nosotros o el propio qbittorrent-nox.
    if len(value) >= 2 and value.startswith('"') and value.endswith('"'):
        value = value[1:-1]
    return value


existing_value = get_value(PASSWORD_KEY)

needs_new_hash = True
if existing_value:
    m = re.match(r"^@ByteArray\((.*):(.*)\)$", existing_value)
    if m:
        try:
            salt = base64.b64decode(m.group(1))
            stored_hash = base64.b64decode(m.group(2))
            if pbkdf2(password, salt) == stored_hash:
                needs_new_hash = False
        except Exception:
            pass

if needs_new_hash:
    salt = secrets.token_bytes(16)
    new_hash = pbkdf2(password, salt)
    salt_b64 = base64.b64encode(salt).decode("ascii")
    hash_b64 = base64.b64encode(new_hash).decode("ascii")
    password_value = f"@ByteArray({salt_b64}:{hash_b64})"
    print("[10-qbittorrent-password] password nueva o distinta a la guardada: regenerando salt + hash PBKDF2")
else:
    password_value = existing_value
    print("[10-qbittorrent-password] password sin cambios respecto al hash guardado: no se reescribe el salt")


def upsert(key: str, value: str) -> None:
    line = f"{key}={value}\n"
    idx = find_line_index(key)
    if idx is not None:
        lines[idx] = line
        return
    for i, existing_line in enumerate(lines):
        if existing_line.rstrip("\n") == "[Preferences]":
            lines.insert(i + 1, line)
            return
    # No debería pasar (init-qbittorrent-config siempre deja [Preferences]),
    # pero si faltara, no queremos perder la password silenciosamente.
    lines.append("[Preferences]\n")
    lines.append(line)


upsert(USERNAME_KEY, username)
upsert(PASSWORD_KEY, password_value)

# Truncar y reescribir en el mismo path (no crear un archivo nuevo): preserva
# el owner abc:abc que dejó init-qbittorrent-config con su lsiown -R.
with open(conf_path, "w") as f:
    f.writelines(lines)

print("[10-qbittorrent-password] WebUI\\Username y WebUI\\Password_PBKDF2 fijados en", conf_path)
PYEOF
