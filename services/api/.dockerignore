# Deny list of generated/host artifacts (015-reproducible-image-builds). Never an
# allow list: an allow list silently drops files a build needs (prisma/,
# nest-cli.json) and only fails inside the running container.
#
# This file is the only thing keeping services/api/.env — which holds a real
# DATABASE_URL — out of the built image (REQ-5).

node_modules/
.git/
.gitignore
Dockerfile
.dockerignore
coverage/
*.tsbuildinfo
npm-debug.log*
.env*
!.env.example

dist/
