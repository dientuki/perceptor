// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Cómo llegó el material a nuestro disco
enum SourceKind {
  TORRENT_SEARCH // El usuario eligió un release del indexer
  TORRENT_FILE // El usuario pegó un magnet o subió un .torrent
  LOCAL_FILE // El usuario pasó la ruta de un archivo
  LOCAL_FOLDER // El usuario pasó la ruta de una carpeta
}

enum SourceStatus {
  PENDING // Creado en el sistema, nada hecho todavía
  QUEUED // (torrent) Entregado al cliente, sin empezar
  DOWNLOADING // (torrent) Descargando activamente
  PAUSED // (torrent) Pausado en cliente
  READY // Archivos disponibles en disco
  SCANNED // Archivos inventariados en source_files
  ERROR // Error en cualquier punto
}

enum EncodeStatus {
  WAITING
  QUEUED
  ENCODING
  COMPLETED
  ERROR
  DISCARDED
  STOPPED
}

// Estado simplificado / consolidado para la UI (Movie, Episode, Track)
enum MediaStatus {
  MISSING // No solicitado o no existe archivo
  QUEUED // Spec 089, REQ-5: waiting behind the torrent client's active-download limit
  DOWNLOADING // Está en cualquiera de los pasos de descarga (SEARCHING, ADDED, DOWNLOADING, etc.)
  PAUSED // Spec 089, REQ-5: a download stopped or lost its race, not actively transferring
  DOWNLOADED // Spec 089, REQ-5: downloaded and waiting to be scanned/encoded
  ENCODING // Está en la cola o siendo procesado por FFmpeg (QUEUED, ENCODING)
  COMPLETED // Todo el flujo finalizó (Descarga + Encode)
  ERROR // Falló la descarga o el encode
}

enum LanguageTrackKind {
  AUDIO
  SUBTITLE
}

enum TorrentGroupScope {
  MOVIE
  SHOW
}

enum ScheduledTaskOutcome {
  SUCCESS
  FAILED
  SKIPPED
}

enum ContentKind {
  LIVE_ACTION
  ANIME
  CGI
}

// Spec 092, REQ-3: a title's own override over the installation's
// grain_auto_enabled Setting; INHERIT never crosses the GraphQL wire.
enum GrainMode {
  INHERIT
  ON
  OFF
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("settings")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String
  password  String
  isAdmin   Boolean  @default(false)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // BCP-47 UI language tag. Null means unset — resolve from Accept-Language, then "en".
  uiLocale String? @db.VarChar(35)

  // Spec 096, REQ-3 NFR-1
  dateMonthFirst Boolean?

  allowCinemaReleases Boolean @default(false)
  acquireTheatrical   Boolean @default(false)
  acquireDigital      Boolean @default(false)
  acquirePhysical     Boolean @default(false)
  audioMandatory      Boolean @default(false)

  // Spec 103, REQ-2
  subtitleSearch Boolean @default(false)

  movies UserMovie[]
  shows  UserShow[]

  languages     UserLanguagePreference[]
  torrentGroups UserTorrentGroup[]

  @@map("users")
}

// Join between User and Movie: whose library a movie is in. The movie row
// itself stays global (Movie.tmdbId @unique) — this table only records
// ownership, not a second copy of the film.
model UserMovie {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId Int
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  audioMandatory Boolean @default(false)

  languages UserMovieLanguage[]

  @@id([userId, movieId])
  @@index([movieId])
  @@map("user_movies")
}

// Join between User and Show: whose library a series is in. The show row
// itself stays global (Show.tmdbId @unique) — this table only records
// ownership, not a second copy of the series.
model UserShow {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  showId Int
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  audioMandatory Boolean @default(false)

  languages UserShowLanguage[]

  @@id([userId, showId])
  @@index([showId])
  @@map("user_shows")
}

model Language {
  id         Int     @id @default(autoincrement())
  tag        String  @unique
  iso2       String
  iso3       String
  trackTitle String?

  userMoviePreferences UserMovieLanguage[]
  userShowPreferences  UserShowLanguage[]
  userPreferences      UserLanguagePreference[]

  @@map("languages")
}

// A user's extra per-title language preference for a film, added to the
// installation's `default_languages` setting (029-settings-screen-tabs;
// the per-user global level, `UserLanguage`/`user_languages`, was dropped).
// Keyed through UserMovie (not User + Movie separately)
// so the preference is removed automatically when the ownership row is.
model UserMovieLanguage {
  userId  String
  movieId Int
  userMovie UserMovie @relation(fields: [userId, movieId], references: [userId, movieId], onDelete: Cascade)

  languageId Int
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  kind LanguageTrackKind @default(AUDIO)

  @@id([userId, movieId, languageId, kind])
  @@index([languageId])
  @@map("user_movie_languages")
}

// A user's extra per-title language preference for a series, added to their
// global preference. Keyed through UserShow (not User + Show separately) so
// the preference is removed automatically when the ownership row is.
model UserShowLanguage {
  userId String
  showId Int
  userShow UserShow @relation(fields: [userId, showId], references: [userId, showId], onDelete: Cascade)

  languageId Int
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  kind LanguageTrackKind @default(AUDIO)

  @@id([userId, showId, languageId, kind])
  @@index([languageId])
  @@map("user_show_languages")
}

model UserLanguagePreference {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  languageId Int
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  kind LanguageTrackKind

  @@id([userId, languageId, kind])
  @@index([languageId])
  @@map("user_language_preferences")
}

model TorrentGroup {
  id   Int    @id @default(autoincrement())
  name String @unique

  users UserTorrentGroup[]

  @@map("torrent_groups")
}

model UserTorrentGroup {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  torrentGroupId Int
  torrentGroup   TorrentGroup @relation(fields: [torrentGroupId], references: [id], onDelete: Cascade)

  scope TorrentGroupScope

  @@id([userId, torrentGroupId, scope])
  @@index([torrentGroupId])
  @@map("user_torrent_groups")
}

// Origen del material para un pedido: torrent, archivo o carpeta local
model MediaSource {
  id Int @id @default(autoincrement())

  kind   SourceKind
  status SourceStatus @default(PENDING)

  // Sólo para kind TORRENT_*: null en los casos locales
  infoHash     String? @unique @db.VarChar(40)
  downloadUrl  String? @db.Text // Magnet o url del .torrent
  releaseTitle String? @db.Text // Nombre del release, para mostrar en la UI

  // Carpeta o archivo donde está el material. Para torrents la llena el cliente
  // al completar; para los casos locales la da el usuario al crear el pedido.
  downloadPath String? @db.VarChar(500)

  // Objetivo del pedido. Las tres relaciones son simétricas desde 022-download-status-tags.
  movieId   Int?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seasonId  Int?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeId Int?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  sourceFiles SourceFile[]

  errorMessage String?  @db.Text
  // Translation key for the failure, e.g. "error.source.scan_no_video". Null on rows written before 018.
  errorKey     String?  @db.VarChar(100)
  // Interpolation values for errorKey, a JSON object encoded as a string. Null when the key takes none.
  errorParams  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Set by sourceScanned, recomputed on every scan (never accumulated): true when at
  // least one *video* file of this download resolved to no episode. Suppresses deletion
  // of the whole download path so the unclassified files stay on disk, but does not
  // suppress the per-episode input deletions for files that did resolve and encode.
  hasUnmatchedFiles Boolean @default(false)

  // Spec 090: set when a delivered source is replaced by a newer one. Null for every
  // live or failed source; `status` is left unchanged so a retired row still derives COMPLETED.
  retiredAt DateTime?

  @@index([status])
  @@index([movieId])
  @@map("media_sources")
}

// El archivo de video de un MediaSource, ya resuelto a qué película/episodio pertenece
model SourceFile {
  id Int @id @default(autoincrement())

  mediaSourceId Int
  mediaSource   MediaSource @relation(fields: [mediaSourceId], references: [id], onDelete: Cascade)

  // Ruta completa tal como está en disco. El original SÍ se borra tras un encode
  // exitoso, sea cual sea el tipo de fuente (torrent o archivo local).
  filePath String @db.VarChar(500)

  movieId   Int?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: SetNull)
  episodeId Int?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  processJob ProcessJob?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mediaSourceId, filePath])
  @@index([movieId])
  @@index([episodeId])
  @@map("source_files")
}

// Tarea de encoding (1 por archivo de video/audio físico)
model ProcessJob {
  id Int @id @default(autoincrement())

  // El input ya no se duplica: sale de sourceFile.filePath
  sourceFileId Int        @unique
  sourceFile   SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  // Denormalizado desde sourceFile para consultar por media sin join extra.
  movieId   Int?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId Int?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  outputFilePath String? @db.VarChar(500)
  ffmpegCommand  String? @db.Text
  progress       Int     @default(0) // 0-100, para la UI de encoding
  encodeSpeed    Float? // FFmpeg's realtime multiplier while ENCODING; null otherwise (REQ-10)

  status       EncodeStatus @default(WAITING)
  errorMessage String?      @db.Text
  // Translation key for the failure, e.g. "error.encode.no_video_stream". Not exposed on any GraphQL type.
  errorKey     String?      @db.VarChar(100)
  // Interpolation values for errorKey, a JSON object encoded as a string. Not exposed on any GraphQL type.
  errorParams  String?      @db.Text

  // How many times this job has been automatically recovered from an interrupted encode
  // (054-interrupted-encode-recovery). Bounded to one; 0 for every pre-feature row.
  recoveryCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("process_jobs")
}

model Movie {
  id               Int       @id @default(autoincrement())
  tmdbId           Int       @unique
  title            String
  overview         String?   @db.Text // Los sinopsis de TMDB pasan el varchar(191) por default
  posterUrl        String?
  releaseDate      DateTime?
  originalLanguage String
  contentKind      ContentKind @default(LIVE_ACTION)
  isShort          Boolean   @default(false)
  // Spec 092, NFR-2: default covers every existing row, no backfill needed.
  grainMode        GrainMode @default(INHERIT)

  theatricalReleaseDate DateTime?
  digitalReleaseDate    DateTime?
  physicalReleaseDate   DateTime?
  tmdbStatus            String?
  catalogClosedAt       DateTime?

  // Estado consolidado para mostrar rápido en tarjetas/listados de la App
  status   MediaStatus @default(MISSING)
  filePath String?     @db.VarChar(500) // Ruta al archivo final procesado

  // Spec 089, REQ-4: the configured media server was observed holding this title.
  // A second possession input alongside filePath — set/cleared by the same reconciliation
  // paths that promote/demote COMPLETED. Not exposed on any GraphQL type.
  mediaServerPresentAt DateTime?

  // Orígenes de descarga vinculados (N:1 desde 022-download-status-tags, ver MediaSource.movieId)
  mediaSources MediaSource[]

  sourceFiles SourceFile[]
  processJobs ProcessJob[]
  users       UserMovie[]

  // Spec 101, REQ-17
  subtitleEmbeds SubtitleEmbed[]

  // Spec 103, REQ-13
  subtitleSearches SubtitleSearch[]

  // Spec 108, REQ-1
  fileAudioLanguages    Json?
  fileSubtitleLanguages Json?
  tracksReadAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("movies")
}

model Show {
  id               Int         @id @default(autoincrement())
  tmdbId           Int         @unique
  title            String
  overview         String?     @db.Text // Los sinopsis de TMDB pasan el varchar(191) por default
  posterUrl        String?
  status           MediaStatus @default(MISSING)
  contentKind      ContentKind @default(LIVE_ACTION)
  // Spec 092, NFR-2: default covers every existing row, no backfill needed.
  grainMode        GrainMode   @default(INHERIT)
  originalLanguage String
  releaseDate      DateTime?
  seasonsSyncedAt  DateTime?
  tmdbStatus       String?

  seasons   Season[]
  users     UserShow[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("shows")
}

model Season {
  id           Int       @id @default(autoincrement())
  showId       Int
  show         Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  seasonNumber Int
  releaseDate  DateTime?

  episodes     Episode[]
  mediaSources MediaSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showId, seasonNumber])
  @@map("seasons")
}

model Episode {
  id            Int       @id @default(autoincrement())
  seasonId      Int
  season        Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeNumber Int
  title         String?
  overview      String?   @db.Text // Los sinopsis de TMDB pasan el varchar(191) por default
  releaseDate   DateTime?

  status   MediaStatus @default(MISSING)
  filePath String?     @db.VarChar(500)

  // Spec 089, REQ-4: the configured media server was observed holding this episode.
  // Same meaning as Movie.mediaServerPresentAt. Not exposed on any GraphQL type.
  mediaServerPresentAt DateTime?

  sourceFiles  SourceFile[]
  mediaSources MediaSource[] // Pedidos de capítulo suelto (S1)
  processJobs  ProcessJob[]

  // Spec 101, REQ-17
  subtitleEmbeds SubtitleEmbed[]

  // Spec 103, REQ-13
  subtitleSearches SubtitleSearch[]

  // Spec 108, REQ-1
  fileAudioLanguages    Json?
  fileSubtitleLanguages Json?
  tracksReadAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, episodeNumber])
  @@map("episodes")
}

enum SubtitleEmbedStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// Spec 101, REQ-17: one request to fold external .srt sidecars into a library .mkv.
// Exactly one of movieId/episodeId is set (enforced in the service, like MediaSource).
model SubtitleEmbed {
  id Int @id @default(autoincrement())

  movieId   Int?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId Int?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  status     SubtitleEmbedStatus @default(QUEUED)
  filePath   String              @db.VarChar(500)
  tracks     Json
  errorKey   String?             @db.VarChar(100)
  warningKey String?             @db.VarChar(100)

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  // Spec 103, REQ-11
  subtitleSearches SubtitleSearch[]

  @@index([movieId, createdAt])
  @@index([episodeId, createdAt])
  @@map("subtitle_embeds")
}

enum SubtitleSearchStatus {
  WAITING
  SEARCHING
  VALIDATING
  EMBEDDING
  COMPLETED
  FAILED
}

enum SubtitleSearchAttemptStatus {
  QUEUED
  RUNNING
  ACCEPTED
  REJECTED
  FAILED
}

enum SubtitleSyncReference {
  SUBTITLE
  AUDIO
}

// Spec 103: one automatic subtitle search for a delivered film or episode.
// Exactly one of movieId/episodeId is set (enforced in the service, like SubtitleEmbed).
model SubtitleSearch {
  id Int @id @default(autoincrement())

  movieId   Int?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId Int?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  status           SubtitleSearchStatus @default(WAITING)
  errorKey         String?              @db.VarChar(100)
  wantedLanguages  Json
  presentLanguages Json?
  libraryPath      String?              @db.VarChar(500)

  // Spec 107
  movieHash      String? @db.VarChar(16)
  fileSizeBytes  BigInt?
  probeCount     Int     @default(0)
  languageErrors Json?

  subtitleEmbedId Int?
  subtitleEmbed   SubtitleEmbed? @relation(fields: [subtitleEmbedId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  attempts SubtitleSearchAttempt[]

  @@index([status])
  @@index([movieId, createdAt])
  @@index([episodeId, createdAt])
  @@index([subtitleEmbedId])
  @@map("subtitle_searches")
}

// Spec 103, REQ-8: one candidate subtitle tried (or queued to be tried) for one language.
model SubtitleSearchAttempt {
  id Int @id @default(autoincrement())

  searchId Int
  search   SubtitleSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  languageIso3       String  @db.VarChar(3)
  providerSubtitleId String  @db.VarChar(255)
  releaseName        String  @db.VarChar(500)
  rank               Int
  stagedPath         String? @db.VarChar(500)
  providerFileName   String? @db.VarChar(500)

  status         SubtitleSearchAttemptStatus @default(QUEUED)
  offsetMs       Int?
  framerateRatio Float?
  reference      SubtitleSyncReference?
  score          Float?
  reasonKey      String?                     @db.VarChar(100)

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([searchId, languageIso3])
  @@map("subtitle_search_attempts")
}

// Append-only diagnostic log of every ffprobe run in the worker, kept independent
// of ProcessJob/SourceFile/MediaSource so it survives cascades that delete the media.
model FfprobeLog {
  id Int @id @default(autoincrement())

  file    String @db.VarChar(500)
  ffprobe String @db.MediumText

  createdAt DateTime @default(now())

  @@index([file])
  @@map("ffprobe_logs")
}

// Derived index mapping a TMDB id to a media server's own item id. No relation to
// Movie/Show: this is a lookup table keyed by tmdbId, rebuilt wholesale on demand, and a
// foreign key would cascade-delete index rows for titles nobody has registered yet.
model MediaServerItem {
  id Int @id @default(autoincrement())

  mediaType  String @db.VarChar(10) // 'movie' | 'show' — see src/types/media.ts MEDIA_TYPE
  tmdbId     Int
  externalId String @db.VarChar(100)

  createdAt DateTime @default(now())

  @@unique([mediaType, tmdbId])
  @@map("media_server_items")
}

// One row per occurrence (scheduled tick or manual trigger) of a task from the
// static registry in src/scheduler/scheduler.registry.ts. No relation to that
// registry: a taskId that is no longer registered just stops accumulating rows.
model ScheduledTaskRun {
  id Int @id @default(autoincrement())

  taskId    String   @db.VarChar(100)
  startedAt DateTime @default(now())

  finishedAt DateTime?

  outcome        ScheduledTaskOutcome
  itemsProcessed Int                  @default(0)
  error          String?              @db.Text

  @@index([taskId, startedAt])
  @@map("scheduled_task_runs")
}
