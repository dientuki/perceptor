#!/usr/bin/with-contenv bash
# with-contenv (no un shebang bash plano): a diferencia de custom-cont-init.d,
# que corre inline durante el init y ya tiene el entorno completo de Docker,
# custom-services.d se registra como servicio de s6 — sin with-contenv arranca
# con un entorno vacío y INDEXER_USER/INDEXER_PASSWORD no llegan al script.
#
# custom-services.d (no custom-cont-init.d): a diferencia de qBittorrent.conf,
# que ya existe con valores por defecto antes de que arranque qbittorrent-nox,
# config.xml de Prowlarr (con su ApiKey) recién lo genera el propio proceso de
# Prowlarr la primera vez que bootea. Un script de custom-cont-init.d corre
# ANTES de esa app y bloquea su arranque hasta terminar — esperar ahí a un
# archivo que el proceso todavía no arrancó produce un deadlock. custom-services.d
# corre como servicio en paralelo: no bloquea el arranque, y si el script termina
# (bien o mal) el propio LinuxServer lo reinicia, lo que además nos da retries
# gratis si algo falla a mitad de camino.

set -euo pipefail

CONFIG_XML="/config/config.xml"
BASE_URL="http://localhost:9696"
INDEXER_USER="${INDEXER_USER:-admin}"

if [ -z "${INDEXER_PASSWORD:-}" ]; then
  echo "[10-prowlarr-credentials] ERROR: INDEXER_PASSWORD está vacío. No fijo ninguna password." >&2
  exit 1
fi

echo "[10-prowlarr-credentials] esperando ${CONFIG_XML} con ApiKey..."
until [ -s "${CONFIG_XML}" ] && grep -q "<ApiKey>" "${CONFIG_XML}"; do
  sleep 2
done

# BusyBox grep no tiene -P; sed básico con grupo capturado alcanza para esta línea.
API_KEY=$(sed -n 's:.*<ApiKey>\(.*\)</ApiKey>.*:\1:p' "${CONFIG_XML}")

echo "[10-prowlarr-credentials] esperando a que la API responda..."
until curl -sf -o /dev/null -H "X-Api-Key: ${API_KEY}" "${BASE_URL}/api/v1/system/status"; do
  sleep 2
done

current=$(curl -sf -H "X-Api-Key: ${API_KEY}" "${BASE_URL}/api/v1/config/host")
current_method=$(echo "${current}" | jq -r '.authenticationMethod')
current_username=$(echo "${current}" | jq -r '.username')

if [ "${current_method}" = "forms" ] && [ "${current_username}" = "${INDEXER_USER}" ]; then
  echo "[10-prowlarr-credentials] ya configurado (forms, username=${INDEXER_USER}), no piso nada."
else
  echo "[10-prowlarr-credentials] fijando authenticationMethod=forms, username=${INDEXER_USER}..."
  updated=$(echo "${current}" | jq \
    --arg user "${INDEXER_USER}" \
    --arg pass "${INDEXER_PASSWORD}" \
    '.authenticationMethod = "forms" | .authenticationRequired = "enabled" | .username = $user | .password = $pass | .passwordConfirmation = $pass')

  curl -sf -X PUT \
    -H "X-Api-Key: ${API_KEY}" \
    -H "Content-Type: application/json" \
    -d "${updated}" \
    "${BASE_URL}/api/v1/config/host" > /dev/null

  echo "[10-prowlarr-credentials] listo."
fi

# Nada más que hacer — dormimos en vez de salir en 0 para no generar reinicios
# innecesarios del servicio.
exec sleep infinity
