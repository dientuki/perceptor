# Deny list of generated/host artifacts (015-reproducible-image-builds). Never an
# allow list: an allow list silently drops files a build needs and only fails
# inside the running container.

node_modules/
.git/
.gitignore
Dockerfile
.dockerignore
coverage/
*.tsbuildinfo
npm-debug.log*
.env*
!.env.example

dist/

# Fixture corpus for src/ffmpeg/cases.spec.ts — test data, never runtime.
ffmpeg/
