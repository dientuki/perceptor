#!/bin/bash
# Construye imágenes (stage runner de cada Dockerfile) sin levantar contenedores.
# Suma el overlay docker-compose.gpu.yaml (mapea /dev/dri al worker) cuando el
# host tiene un render node en /dev/dri, salvo que USE_GPU sea exactamente
# "false" — la única forma de forzar el path por CPU. Acepta un servicio
# opcional entre web/api/worker/torrent/indexer; sin argumento construye los
# cinco. db, redis, traefik y flaresolverr no tienen build: en el compose y no
# son targets válidos.
set -e
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
  echo ".env no existe. Corré bin/install primero."
  exit 1
fi

set -a; . ./.env; set +a

BUILDABLE="web api worker torrent indexer"

if [ -n "$1" ]; then
  case " $BUILDABLE " in
    *" $1 "*)
      TARGETS="$1"
      ;;
    *)
      echo "Uso: bin/build [web|api|worker|torrent|indexer]"
      exit 1
      ;;
  esac
else
  TARGETS="$BUILDABLE"
fi

COMPOSE_FILES="-f docker-compose.yaml"
if [ -d /dev/dri ] && [ "${USE_GPU}" != "false" ]; then
  COMPOSE_FILES="$COMPOSE_FILES -f docker-compose.gpu.yaml"
fi

BUILD_TARGET=runner docker compose $COMPOSE_FILES build $TARGETS
