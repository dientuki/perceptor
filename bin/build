#!/bin/bash
# Builds images from the target Dockerfile stage given as $1 (dev or prod),
# without starting containers. Accepts an optional service between
# web/api/worker/torrent/indexer as $2; with no service, builds all five.
# db, redis, traefik and flaresolverr have no build: in the compose and are
# not valid targets.
set -e
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
  echo ".env no existe. Corré bin/install primero."
  exit 1
fi

set -a; . ./.env; set +a

TARGETS_ALLOWED="dev prod"
BUILDABLE="web api worker torrent indexer"

case " $TARGETS_ALLOWED " in
  *" $1 "*)
    ;;
  *)
    echo "Uso: bin/build <dev|prod> [web|api|worker|torrent|indexer]"
    exit 1
    ;;
esac

if [ -n "$2" ]; then
  case " $BUILDABLE " in
    *" $2 "*)
      TARGETS="$2"
      ;;
    *)
      echo "Uso: bin/build <dev|prod> [web|api|worker|torrent|indexer]"
      exit 1
      ;;
  esac
else
  TARGETS="$BUILDABLE"
fi

COMPOSE_FILES="-f docker-compose.yaml -f docker-compose.build.yaml"

BUILD_TARGET="$1" docker compose $COMPOSE_FILES build $TARGETS
