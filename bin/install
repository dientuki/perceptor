#!/bin/bash
# Genera .env a partir de .env.example, preguntando si el stack se va a rutear
# por Traefik (dominios) o por puertos directos en localhost.
set -e
cd "$(dirname "$0")/.."

if [ -f .env ]; then
  read -rp ".env ya existe. ¿Sobreescribirlo? [y/N] " overwrite
  case "$overwrite" in
    [yY]*) ;;
    *) echo "Cancelado."; exit 0 ;;
  esac
fi

cp .env.example .env

read -rp "¿Usar Traefik para rutear por dominio? [y/N] " use_traefik
case "$use_traefik" in
  [yY]*)
    read -rp "Dominio a usar (ej: perceptor.local): " domain
    sed -i "s/^USE_TRAEFIK=.*/USE_TRAEFIK=true/" .env
    sed -i "s/^DOMAIN=.*/DOMAIN=${domain}/" .env
    echo
    echo "Listo. Agregá esto a /etc/hosts para que resuelva:"
    echo "  127.0.0.1  ${domain} api.${domain} torrent.${domain} indexer.${domain}"
    ;;
  *)
    sed -i "s/^USE_TRAEFIK=.*/USE_TRAEFIK=false/" .env
    echo
    echo "Traefik desactivado. Vas a acceder a cada servicio por su puerto en localhost"
    echo "(WEB_PORT, API_PORT, INDEXER_PORT, QBITTORRENT_WEBUI_PORT)."
    ;;
esac

echo
echo ".env creado a partir de .env.example — completá el resto de las variables antes de levantar el stack."
echo "Después corré: bin/dev"
