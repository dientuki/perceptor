#!/bin/bash
# Genera .env a partir de .env.example (si no existe, o si se pide
# regenerarlo), preguntando si el stack se va a rutear por Traefik. Siempre
# sigue con la base: levanta db/redis/api, resetea la base (destructivo a
# propósito — install arma un ambiente limpio, no lo actualiza) y siembra los
# datos iniciales. Al final frena los containers: instalar no implica dejar
# el stack corriendo, eso lo decide el usuario con bin/dev.
set -e
cd "$(dirname "$0")/.."

set_env_var() {
  # sed -i no es portable (GNU vs BSD/macOS piden flags distintos): escribir a
  # un temporal y mover evita la diferencia por completo. Delimitador '|' en vez
  # de '/' porque algunos valores (rutas) contienen '/'.
  sed "s|^${1}=.*|${1}=${2}|" .env > .env.tmp && mv .env.tmp .env
}

ensure_env_var() {
  # Como set_env_var, pero agrega la línea si no existe todavía — necesario
  # para variables agregadas a .env.example después de que el .env del
  # usuario ya existía (JWT_SECRET, SERVICE_TOKEN de 002-auth-login): en la
  # rama "uso el .env existente" set_env_var por sí sola no haría nada.
  if grep -q "^${1}=" .env; then
    set_env_var "$1" "$2"
  else
    echo "${1}=${2}" >> .env
  fi
}

generate_env=true
if [ -f .env ]; then
  read -rp ".env already exists. Regenerate it from .env.example? [y/N] " overwrite
  case "$overwrite" in
    [yY]*) ;;
    *) generate_env=false ;;
  esac
fi

if [ "$generate_env" = true ]; then
  cp .env.example .env

  read -rp "Use Traefik to route by domain? [y/N] " use_traefik
  case "$use_traefik" in
    [yY]*)
      read -rp "Domain to use (e.g. perceptor.local): " domain
      set_env_var USE_TRAEFIK true
      set_env_var DOMAIN "${domain}"
      set_env_var PUBLIC_UPLOAD_URL "http://api.${domain}/uploads"
      echo
      echo "Done. Add this to /etc/hosts so it resolves:"
      echo "  127.0.0.1  ${domain} api.${domain} torrent.${domain} indexer.${domain}"
      ;;
    *)
      set_env_var USE_TRAEFIK false
      # El navegador pega directo acá (POST /uploads, tus), no por la red docker interna
      # que usa INTERNAL_GRAPHQL_URL — "localhost" sólo sirve si accedés desde esta misma
      # máquina. macOS no tiene `ip`, de ahí el fallback a ipconfig.
      api_port=$(grep '^API_PORT=' .env | cut -d= -f2-)
      if command -v ip >/dev/null 2>&1; then
        host_ip=$(ip route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
      fi
      if [ -z "$host_ip" ] && command -v ipconfig >/dev/null 2>&1; then
        host_ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)
      fi
      host_ip="${host_ip:-localhost}"
      set_env_var PUBLIC_UPLOAD_URL "http://${host_ip}:${api_port}/uploads"
      echo
      echo "Traefik disabled. You will reach each service on its own localhost port"
      echo "(WEB_PORT, API_PORT, INDEXER_PORT, QBITTORRENT_WEBUI_PORT)."
      echo "PUBLIC_UPLOAD_URL is set to http://${host_ip}:${api_port}/uploads. If you will upload"
      echo "files from another computer or phone on the network and that is not the right IP, fix it"
      echo "by hand in .env."
      ;;
  esac

  read -rp "Enter the downloads folder [./data/downloads]: " downloads_dir
  set_env_var HOST_DOWNLOADS_DIR "${downloads_dir:-./data/downloads}"

  read -rp "Enter your media server folder [./data/library]: " destinations_dir
  set_env_var HOST_DESTINATIONS_DIR "${destinations_dir:-./data/library}"

  echo
  echo ".env created from .env.example — fill in the remaining variables (ports,"
  echo "credentials, download paths) before continuing if the defaults do not suit you."
else
  echo "Using the existing .env."
fi

# JWT_SECRET tiene que existir ANTES de levantar api más abajo: sin él,
# assertAuthEnv() (services/api/src/auth/auth.constants.ts) hace fallar el
# boot a propósito (AC-8, REQ-6) — así que un JWT_SECRET vacío acá dejaría a
# api reiniciándose en loop y el --wait de más abajo terminaría en timeout.
# Sólo se genera si está vacío: no pisa un secreto que el usuario ya haya
# puesto a mano en un .env reusado.
current_jwt_secret=$(grep '^JWT_SECRET=' .env 2>/dev/null | cut -d= -f2-)
if [ -z "$current_jwt_secret" ]; then
  echo "Generating JWT_SECRET..."
  ensure_env_var JWT_SECRET "$(openssl rand -hex 32)"
fi

current_indexer_api_key=$(grep '^INDEXER_API_KEY=' .env 2>/dev/null | cut -d= -f2-)
if [ -z "$current_indexer_api_key" ]; then
  echo "Looking for an existing INDEXER_API_KEY in the indexer volume..."
  # Build aparte y silencioso: si se lo dejamos a "docker compose run", un build
  # necesario (imagen ausente) manda su log a stdout y se mezcla con el resultado
  # del sed de más abajo — ese log terminó una vez escrito en INDEXER_API_KEY.
  # docker-compose.build.yaml, no la base: es ahí donde vive el build: de indexer
  # desde que docker-compose.yaml pasó a describir sólo imágenes publicadas (049).
  docker compose -f docker-compose.yaml -f docker-compose.build.yaml build --quiet indexer
  # --entrypoint /bin/sh evita la cadena /init de LinuxServer (no arranca nada) y --no-deps
  # evita arrastrar a flaresolverr sólo para leer un archivo.
  existing_key=$(docker compose -f docker-compose.yaml -f docker-compose.build.yaml run --rm --no-deps --entrypoint /bin/sh indexer \
    -c 'sed -n "s:.*<ApiKey>\(.*\)</ApiKey>.*:\1:p" /config/config.xml 2>/dev/null' | tr -d '\r\n')
  if [ -n "$existing_key" ]; then
    echo "Found it, adopting the existing key from the indexer volume (does not invalidate your configured Prowlarr)."
    ensure_env_var INDEXER_API_KEY "$existing_key"
  else
    echo "No previous volume found, generating INDEXER_API_KEY..."
    ensure_env_var INDEXER_API_KEY "$(openssl rand -hex 16)"
  fi
  echo "Note: if you had a FlareSolverr running separately via 'docker run', it is no longer needed —"
  echo "it now lives inside the stack. You can stop it."
fi

set -a; . ./.env; set +a

while true; do
  read -rsp "Password for ${ADMIN_USER} (minimum 6 characters): " admin_password; echo
  if [ "${#admin_password}" -lt 6 ]; then
    echo "The password must be at least 6 characters long." >&2
    continue
  fi
  read -rsp "Repeat the password: " admin_password_confirm; echo
  if [ "$admin_password" != "$admin_password_confirm" ]; then
    echo "The passwords do not match." >&2
    continue
  fi
  break
done
unset admin_password_confirm

# Mismo overlay que bin/dev: sin docker-compose.dev.yaml no hay bind mount
# ./services/<svc>:/app, así que /app queda como lo dejó el Dockerfile (root,
# creado por WORKDIR) y el "npm install" del CMD de dev, corriendo como
# PUID:PGID, falla con EACCES al escribir package-lock.json.
COMPOSE_FILES="-f docker-compose.yaml -f docker-compose.build.yaml -f docker-compose.dev.yaml"

echo
echo "Starting services... this can take a minute the first time the containers are created."
if ! BUILD_TARGET=dev docker compose $COMPOSE_FILES up -d --wait --wait-timeout 180 db redis api web torrent indexer flaresolverr torrent worker; then
  # Sin este mensaje, `set -e` corta acá con sólo el error crudo de compose. `up -d` ya lanzó
  # los containers antes de fallar el --wait, así que pueden seguir corriendo de fondo; y este
  # script es reentrante (no pisa nada ya configurado), así que la salida es correrlo de nuevo.
  echo >&2
  echo "ERROR: the services did not become 'healthy' within the 180-second wait." >&2
  echo "The containers may still be running — check with:" >&2
  echo "  docker compose ps" >&2
  echo "Wait a moment and run bin/install again: it is re-entrant." >&2
  exit 1
fi

# Un container "healthy" no implica un container instalado: node_modules está
# bind-mounteado desde el host, así que se puede borrar con el container arriba
# y el proceso de Nest sigue respondiendo el healthcheck con los módulos ya
# cargados en memoria. Sin este chequeo, npx se pondría a bajar prisma del
# registry con un prompt interactivo en medio del script.
if ! docker compose exec -T api test -x node_modules/.bin/prisma; then
  echo "Missing node dependencies in api, installing..."
  docker compose exec -T api npm install
  # El nest --watch que quedó vivo entró en estado roto al desaparecer
  # typescript y no se recupera solo: reiniciar lo deja corriendo con las
  # dependencias nuevas.
  echo "Restarting api so it picks up the new dependencies..."
  docker compose restart api
  if ! BUILD_TARGET=dev docker compose $COMPOSE_FILES up -d --wait --wait-timeout 300 api; then
    echo >&2
    echo "ERROR: api did not become 'healthy' again within the 300-second wait after npm install." >&2
    echo "Check with:" >&2
    echo "  docker compose logs api" >&2
    echo "Wait a moment and run bin/install again: it is re-entrant." >&2
    exit 1
  fi
fi

# SERVICE_TOKEN recién se puede mintear con api ya arriba (el script vive en
# services/api/scripts/, corre adentro del container). Igual que JWT_SECRET,
# sólo si todavía no hay uno — no pisa un token que el usuario ya haya
# generado a mano (por ejemplo después de rotar JWT_SECRET manualmente).
# --T (sin pseudo-tty) en vez de bin/npm/bin/cli porque acá se captura stdout
# con command substitution, mismo motivo que el chequeo de prisma más arriba.
current_service_token=$(grep '^SERVICE_TOKEN=' .env 2>/dev/null | cut -d= -f2-)
if [ -z "$current_service_token" ]; then
  echo "Minting SERVICE_TOKEN..."
  service_token=$(docker compose exec -T api npm run --silent token:service)
  # Un SERVICE_TOKEN vacío en .env falla en silencio: torrent y worker arrancan igual,
  # pero no pueden autenticarse contra la api, y no hay ningún error visible en los
  # logs de api ni worker (sólo en el AutoRun hook de qBittorrent, que nadie mira).
  if [ -z "$service_token" ]; then
    echo "ERROR: minting SERVICE_TOKEN returned nothing. Retry manually with:" >&2
    echo "  docker compose exec api npm run --silent token:service" >&2
    echo "and paste the result into SERVICE_TOKEN in .env, then run:" >&2
    echo "  docker compose up -d torrent worker" >&2
    exit 1
  fi
  ensure_env_var SERVICE_TOKEN "$service_token"
fi

echo "Granting privileges to ${DB_USER} in MariaDB..."
bin/dbinit

PERCEPTOR_SKIP_PASSWORD_PROMPT=1 bin/dbreset

echo "Setting the password for ${ADMIN_USER} in the app, qBittorrent and Prowlarr..."
if ! printf '%s\n%s\n' "$admin_password" "$admin_password" | docker compose $COMPOSE_FILES exec -T api npx --no ts-node scripts/reset-password.ts "$ADMIN_USER"; then
  echo "ERROR: could not set the password. Retry with:" >&2
  echo "  bin/reset-password ${ADMIN_USER}" >&2
  exit 1
fi
unset admin_password

echo
echo "Stopping the containers..."
docker compose stop

echo
echo "Done. Run bin/dev to bring the stack up."
echo "Your username is: ${ADMIN_USER}. To change or recover the password, run: bin/reset-password ${ADMIN_USER}"
