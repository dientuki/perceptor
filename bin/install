#!/bin/bash
# Genera .env a partir de .env.example (si no existe, o si se pide
# regenerarlo), preguntando si el stack se va a rutear por Traefik. Siempre
# sigue con la base: levanta db/redis/api, resetea la base (destructivo a
# propósito — install arma un ambiente limpio, no lo actualiza) y siembra los
# datos iniciales. Al final frena los containers: instalar no implica dejar
# el stack corriendo, eso lo decide el usuario con bin/dev.
set -e
cd "$(dirname "$0")/.."

set_env_var() {
  # sed -i no es portable (GNU vs BSD/macOS piden flags distintos): escribir a
  # un temporal y mover evita la diferencia por completo. Delimitador '|' en vez
  # de '/' porque algunos valores (rutas) contienen '/'.
  sed "s|^${1}=.*|${1}=${2}|" .env > .env.tmp && mv .env.tmp .env
}

ensure_env_var() {
  # Como set_env_var, pero agrega la línea si no existe todavía — necesario
  # para variables agregadas a .env.example después de que el .env del
  # usuario ya existía (JWT_SECRET, SERVICE_TOKEN de 002-auth-login): en la
  # rama "uso el .env existente" set_env_var por sí sola no haría nada.
  if grep -q "^${1}=" .env; then
    set_env_var "$1" "$2"
  else
    echo "${1}=${2}" >> .env
  fi
}

generate_env=true
if [ -f .env ]; then
  read -rp ".env ya existe. ¿Regenerarlo desde .env.example? [y/N] " overwrite
  case "$overwrite" in
    [yY]*) ;;
    *) generate_env=false ;;
  esac
fi

if [ "$generate_env" = true ]; then
  cp .env.example .env

  read -rp "¿Usar Traefik para rutear por dominio? [y/N] " use_traefik
  case "$use_traefik" in
    [yY]*)
      read -rp "Dominio a usar (ej: perceptor.local): " domain
      set_env_var USE_TRAEFIK true
      set_env_var DOMAIN "${domain}"
      echo
      echo "Listo. Agregá esto a /etc/hosts para que resuelva:"
      echo "  127.0.0.1  ${domain} api.${domain} torrent.${domain} indexer.${domain}"
      ;;
    *)
      set_env_var USE_TRAEFIK false
      echo
      echo "Traefik desactivado. Vas a acceder a cada servicio por su puerto en localhost"
      echo "(WEB_PORT, API_PORT, INDEXER_PORT, QBITTORRENT_WEBUI_PORT)."
      ;;
  esac

  read -rp "¿Usar la GPU del host para acelerar el encode (tonemap 4K HDR/DoVi)? [y/N] " use_gpu
  case "$use_gpu" in
    [yY]*)
      set_env_var USE_GPU true
      echo
      echo "GPU activada. Necesita /dev/dri en el host (GPU Intel confirmada; otras GPUs con"
      echo "soporte Vulkan probablemente funcionen, no probado). El encode AV1 en sí sigue"
      echo "corriendo por CPU siempre — ninguna GPU acá lo hace por hardware."
      ;;
    *)
      set_env_var USE_GPU false
      ;;
  esac

  read -rp "Ingrese la carpeta de descargas [./data/downloads]: " downloads_dir
  set_env_var HOST_DOWNLOADS_DIR "${downloads_dir:-./data/downloads}"

  read -rp "Ingrese la carpeta de tu media server [./data/library]: " destinations_dir
  set_env_var HOST_DESTINATIONS_DIR "${destinations_dir:-./data/library}"

  echo
  echo ".env creado a partir de .env.example — completá el resto de las variables (puertos,"
  echo "credenciales, rutas de descarga) antes de seguir si los defaults no te sirven."
else
  echo "Uso el .env existente."
fi

# JWT_SECRET tiene que existir ANTES de levantar api más abajo: sin él,
# assertAuthEnv() (services/api/src/auth/auth.constants.ts) hace fallar el
# boot a propósito (AC-8, REQ-6) — así que un JWT_SECRET vacío acá dejaría a
# api reiniciándose en loop y el --wait de más abajo terminaría en timeout.
# Sólo se genera si está vacío: no pisa un secreto que el usuario ya haya
# puesto a mano en un .env reusado.
current_jwt_secret=$(grep '^JWT_SECRET=' .env 2>/dev/null | cut -d= -f2-)
if [ -z "$current_jwt_secret" ]; then
  echo "Generando JWT_SECRET..."
  ensure_env_var JWT_SECRET "$(openssl rand -hex 32)"
fi

current_indexer_api_key=$(grep '^INDEXER_API_KEY=' .env 2>/dev/null | cut -d= -f2-)
if [ -z "$current_indexer_api_key" ]; then
  echo "Buscando una INDEXER_API_KEY existente en el volumen de indexer..."
  # --entrypoint /bin/sh evita la cadena /init de LinuxServer (no arranca nada) y --no-deps
  # evita arrastrar a flaresolverr sólo para leer un archivo.
  existing_key=$(docker compose run --rm --no-deps --entrypoint /bin/sh indexer \
    -c 'sed -n "s:.*<ApiKey>\(.*\)</ApiKey>.*:\1:p" /config/config.xml 2>/dev/null' | tr -d '\r\n')
  if [ -n "$existing_key" ]; then
    echo "Encontrada, adoptando la key existente del volumen de indexer (no invalida tu Prowlarr configurado)."
    ensure_env_var INDEXER_API_KEY "$existing_key"
  else
    echo "No hay volumen previo, generando INDEXER_API_KEY..."
    ensure_env_var INDEXER_API_KEY "$(openssl rand -hex 16)"
  fi
  echo "Nota: si tenías un FlareSolverr corriendo aparte con 'docker run', ya no hace falta —"
  echo "ahora vive dentro del stack. Podés pararlo."
fi

set -a; . ./.env; set +a

echo
echo "Levantando db, redis y api..."
BUILD_TARGET=dev docker compose up -d --wait --wait-timeout 180 db redis api

# Un container "healthy" no implica un container instalado: node_modules está
# bind-mounteado desde el host, así que se puede borrar con el container arriba
# y el proceso de Nest sigue respondiendo el healthcheck con los módulos ya
# cargados en memoria. Sin este chequeo, npx se pondría a bajar prisma del
# registry con un prompt interactivo en medio del script.
if ! docker compose exec -T api test -x node_modules/.bin/prisma; then
  echo "Faltan dependencias de node en api, instalando..."
  docker compose exec -T api npm install
  # El nest --watch que quedó vivo entró en estado roto al desaparecer
  # typescript y no se recupera solo: reiniciar lo deja corriendo con las
  # dependencias nuevas.
  echo "Reiniciando api para que levante con las dependencias nuevas..."
  docker compose restart api
  BUILD_TARGET=dev docker compose up -d --wait --wait-timeout 300 api
fi

# SERVICE_TOKEN recién se puede mintear con api ya arriba (el script vive en
# services/api/scripts/, corre adentro del container). Igual que JWT_SECRET,
# sólo si todavía no hay uno — no pisa un token que el usuario ya haya
# generado a mano (por ejemplo después de rotar JWT_SECRET manualmente).
# --T (sin pseudo-tty) en vez de bin/npm/bin/cli porque acá se captura stdout
# con command substitution, mismo motivo que el chequeo de prisma más arriba.
current_service_token=$(grep '^SERVICE_TOKEN=' .env 2>/dev/null | cut -d= -f2-)
if [ -z "$current_service_token" ]; then
  echo "Minteando SERVICE_TOKEN..."
  service_token=$(docker compose exec -T api npm run --silent token:service)
  ensure_env_var SERVICE_TOKEN "$service_token"
fi

echo "Otorgando privilegios a ${DB_USER} en MariaDB..."
bin/dbinit

echo "Reseteando la base y aplicando migraciones de Prisma..."
bin/cli api npx --no prisma migrate reset --force

# migrate reset no siembra solo pese a que prisma.config.ts declara un
# comando de seed (verificado: la tabla languages queda en 0 filas después
# del reset) — hay que correrlo aparte.
echo "Sembrando datos iniciales..."
bin/cli api npx --no ts-node prisma/seeds/index.ts

echo
echo "Frenando los containers..."
docker compose stop

echo
echo "Listo. Corré bin/dev para levantar el stack (web, api, db, redis, torrent, indexer)."
