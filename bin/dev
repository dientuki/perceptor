#!/bin/bash
# Levanta el stack en modo desarrollo. Lee USE_TRAEFIK de .env para decidir si
# el servicio traefik entra (y USE_HTTPS para sumar el one-shot certs) en el docker compose up. Los argumentos se pasan
# tal cual a `docker compose up` antes de la lista de servicios — pasá `-d`
# vos mismo si querés que quede en segundo plano; sin argumentos corre en
# primer plano, mostrando los logs.
set -e
cd "$(dirname "$0")/.."

. "$(dirname "$0")/_docker.sh"
require_docker

if [ ! -f .env ]; then
  echo ".env no existe. Corré bin/install primero."
  exit 1
fi

set -a; . ./.env; set +a

SERVICES="db redis api web worker torrent indexer flaresolverr"
if [ "${USE_TRAEFIK}" = "true" ]; then
  SERVICES="traefik $SERVICES"
fi

COMPOSE_FILES="-f docker-compose.yaml -f docker-compose.build.yaml -f docker-compose.dev.yaml"

# certs is a one-shot that writes the local CA and the Traefik leaf certificate. It runs to
# completion first and aborts the script on failure: traefik's depends_on on it is optional
# (required: false), which compose treats as "skip" when certs fails, not as "do not start".
if [ "${USE_TRAEFIK}" = "true" ] && [ "${USE_HTTPS}" = "true" ]; then
  BUILD_TARGET=dev docker compose $COMPOSE_FILES run --rm --no-deps certs
fi

BUILD_TARGET=dev docker compose $COMPOSE_FILES up "$@" $SERVICES
