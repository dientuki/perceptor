#!/bin/bash
# Levanta el stack en modo desarrollo. Lee USE_TRAEFIK de .env para decidir si
# el servicio traefik entra en el docker compose up. Los argumentos se pasan
# tal cual a `docker compose up` antes de la lista de servicios — pasá `-d`
# vos mismo si querés que quede en segundo plano; sin argumentos corre en
# primer plano, mostrando los logs.
#
# --build es obligatorio acá: docker-compose.build.yaml taguea siempre
# perceptor-<svc>:local sin importar el target (dev o runner), así que un
# bin/build o bin/prod previo deja una imagen runner con ese mismo tag —
# sin --build, `docker compose up` la reusaría tal cual en vez de reconstruir
# en modo dev.
set -e
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
  echo ".env no existe. Corré bin/install primero."
  exit 1
fi

set -a; . ./.env; set +a

SERVICES="db redis api web worker torrent indexer flaresolverr"
if [ "${USE_TRAEFIK}" = "true" ]; then
  SERVICES="traefik $SERVICES"
fi

COMPOSE_FILES="-f docker-compose.yaml -f docker-compose.build.yaml -f docker-compose.dev.yaml"

BUILD_TARGET=dev docker compose $COMPOSE_FILES up --build "$@" $SERVICES
