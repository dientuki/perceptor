#!/bin/bash
# Levanta el stack en modo desarrollo. Lee USE_TRAEFIK de .env para decidir si
# el servicio traefik entra en el docker compose up. Suma el overlay
# docker-compose.gpu.yaml (mapea /dev/dri al worker) cuando el host tiene un
# render node en /dev/dri, salvo que USE_GPU sea exactamente "false" — la
# única forma de forzar el path por CPU.
set -e
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
  echo ".env no existe. Corré bin/install primero."
  exit 1
fi

set -a; . ./.env; set +a

SERVICES="db redis api web worker torrent indexer flaresolverr"
if [ "${USE_TRAEFIK}" = "true" ]; then
  SERVICES="traefik $SERVICES"
fi

COMPOSE_FILES="-f docker-compose.yaml -f docker-compose.dev.yaml"
if [ -d /dev/dri ] && [ "${USE_GPU}" != "false" ]; then
  COMPOSE_FILES="$COMPOSE_FILES -f docker-compose.gpu.yaml"
fi

BUILD_TARGET=dev docker compose $COMPOSE_FILES up $SERVICES
