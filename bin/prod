#!/bin/bash
# Levanta el stack en modo producción (stage prod de cada Dockerfile, sin
# bind mounts de código). Lee USE_TRAEFIK de .env para decidir si el servicio
# traefik entra en el docker compose up.
set -e
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
  echo ".env no existe. Corré bin/install primero."
  exit 1
fi

set -a; . ./.env; set +a

SERVICES="db redis api web worker torrent indexer flaresolverr"
if [ "${USE_TRAEFIK}" = "true" ]; then
  SERVICES="traefik $SERVICES"
fi

COMPOSE_FILES="-f docker-compose.yaml -f docker-compose.build.yaml"

BUILD_TARGET=prod docker compose $COMPOSE_FILES up -d --build $SERVICES
