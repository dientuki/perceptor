#!/bin/bash
# Levanta el stack en modo producción (stage runner de cada Dockerfile). Lee
# USE_TRAEFIK de .env para decidir si el servicio traefik entra en el docker
# compose up, y USE_GPU para sumar el overlay docker-compose.gpu.yaml (mapea
# /dev/dri al worker).
set -e
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
  echo ".env no existe. Corré bin/install primero."
  exit 1
fi

set -a; . ./.env; set +a

SERVICES="db redis api web worker torrent indexer flaresolverr"
if [ "${USE_TRAEFIK}" = "true" ]; then
  SERVICES="traefik $SERVICES"
fi

COMPOSE_FILES="-f docker-compose.yaml"
if [ "${USE_GPU}" = "true" ]; then
  COMPOSE_FILES="$COMPOSE_FILES -f docker-compose.gpu.yaml"
fi

BUILD_TARGET=runner docker compose $COMPOSE_FILES up -d --build $SERVICES
