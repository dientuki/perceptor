# Copy to .env (bin/install does this for you) and adjust as needed. Defaults below are meant to
# work out of the box for local dev. See CLAUDE.md "Environment" for what each var feeds.

NODE_ENV=development
TZ=UTC
PUID=1000
PGID=1000
# Gid del grupo dueño de las carpetas de media (worker escribe la biblioteca final,
# ver HOST_DESTINATIONS_DIR más abajo). Se agrega via group_add en vez de reusar PGID
# porque PGID también lo consumen torrent/indexer, con su propio significado ahí.
# Default: mismo valor que PGID.
MEDIA_GID=1000

# Set by `bin/install`. true routes web/api/torrent/indexer through Traefik by Host()
# (needs a resolvable DOMAIN, e.g. an /etc/hosts entry); false skips traefik and exposes
# each service directly on its port. bin/dev and bin/prod read this.
USE_TRAEFIK=false
DOMAIN=perceptor.local

# Set by `bin/install`. true mounts /dev/dri into worker (docker-compose.gpu.yaml) so
# libplacebo can tonemap 4K HDR/DoVi on the host's GPU instead of falling back to a much
# slower CPU path — needs a host with a render node at /dev/dri (Intel iGPU, confirmed
# working; AMD/other Vulkan-capable GPUs likely work too, untested). AV1 encoding itself
# always runs on CPU regardless of this flag — no GPU here can encode AV1 in hardware.
USE_GPU=false

# Optional: dev | runner. bin/dev and bin/prod set this themselves; leave unset otherwise.
BUILD_TARGET=dev

# Shared login for the app itself, qBittorrent's WebUI and Prowlarr's WebUI (see QBITTORRENT_USER/
# INDEXER_USER below) — one place to change all three. Each service's own UI can still change its
# own credentials later independently of what's seeded here.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# JWT signing secret (002-auth-login). The api refuses to boot without it — no default, ever
# (REQ-6). `bin/install` generates this with `openssl rand -hex 32` on a fresh checkout. To
# generate it yourself: `openssl rand -hex 32`.
JWT_SECRET=

# The machine credential the worker and the qBittorrent AutoRun hook authenticate with (REQ-5) —
# a JWT with no expiry, signed with JWT_SECRET above, carrying no user identity. `bin/install`
# mints this automatically once `api` is up. To mint it yourself once the stack is running:
# `bin/npm api run token:service --silent`.
# IMPORTANT: rotating JWT_SECRET invalidates this token — re-mint it after any JWT_SECRET change,
# or the worker and the AutoRun hook will start failing every call with "No autenticado" (the
# silent-pipeline-break risk this feature is most worried about, NFR-2).
SERVICE_TOKEN=

WEB_PORT=3000
API_PORT=4000
# URL del endpoint de subida (/uploads en la api), tal como la resuelve el BROWSER —
# no la interna de Docker (http://api:4000) que usa INTERNAL_GRAPHQL_URL, el browser no
# puede resolver esa. Con Traefik: http://api.${DOMAIN}/uploads. Sin Traefik, o para subir
# desde otro dispositivo de la red (celular, otra PC), usá la IP del host: http://<ip-del-host>:${API_PORT}/uploads.
PUBLIC_UPLOAD_URL=http://api.perceptor.local/uploads
DB_PORT=3306
# Redis binds its default port (6379) inside the container regardless of this value — the
# compose port mapping needs REDIS_PORT to match, so only change this together with that.
REDIS_PORT=6379
# Prowlarr's web UI always listens on 9696 inside the container, same reasoning as REDIS_PORT.
INDEXER_PORT=9696
INDEXER_USER=${ADMIN_USER}
INDEXER_PASSWORD=${ADMIN_PASSWORD}
# Prowlarr's API key. `bin/install` fills this (adopting an existing key out of the indexer
# volume if there is one, generating a fresh one otherwise) — never fill it in by hand. The
# api reads this same value as its `tracker_api_key` setting (services/api/src/clients/indexer).
INDEXER_API_KEY=

QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENTING_PORT=6881
QBITTORRENT_USER=${ADMIN_USER}
# qBittorrent's init script refuses to start if this is empty — change it, don't blank it.
QBITTORRENT_PASSWORD=${ADMIN_PASSWORD}

DB_HOST=db
# devuser/devpassword/perceptor match the DSN hardcoded in prisma.service.ts (known debt: it
# ignores DATABASE_URL below). Changing these three without also editing that file will leave
# the api unable to connect.
DB_NAME=perceptor
DB_USER=devuser
DB_PASSWORD=devpassword
DB_ROOT_PASSWORD=rootpassword
DATABASE_URL=mysql://devuser:devpassword@db:3306/perceptor

REDIS_HOST=redis

# Host paths for downloads / library. Relative paths resolve from the repo root; Docker creates
# them (as root) on first boot if they don't exist yet — point these at real folders once you
# have media to manage.
# These are the roots the Settings UI is confined to (see api's src/media-roots/): the app can
# only pick a subfolder inside them, shown as HOST_*_DIR + a relative segment — it never shows or
# lets you type a CONTAINER_*_DIR path.
HOST_DOWNLOADS_DIR=./data/downloads
HOST_DESTINATIONS_DIR=./data/library
CONTAINER_DOWNLOADS_DIR=/media/downloads
CONTAINER_DESTINATIONS_DIR=/media/library

# ffmpeg | mock. mock copies the input and simulates progress (no ffmpeg/mkvmerge involved) —
# useful to exercise the rest of the pipeline (move to library, remove torrent, notify media
# server) without waiting on a real encode. See services/worker/src/encode/.
ENCODE_DRIVER=ffmpeg
# Seconds to encode via `-t`, instead of the whole file. Leave empty for a real full-length
# encode; set to e.g. 5 while testing so a run takes seconds, not hours.
ENCODE_SAMPLE_SECONDS=
# Only read by ENCODE_DRIVER=mock: how many seconds the simulated encode takes.
ENCODE_MOCK_SECONDS=5
