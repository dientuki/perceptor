# Copy to .env and fill in real values. See CLAUDE.md "Environment" for what each var feeds.

NODE_ENV=development
TZ=
PUID=
PGID=

# Set by `bin/install`. true routes web/api/torrent/indexer through Traefik by Host()
# (needs a resolvable DOMAIN, e.g. an /etc/hosts entry); false skips traefik and exposes
# each service directly on its port. bin/dev and bin/prod read this.
USE_TRAEFIK=false
DOMAIN=

# Optional: dev | runner. Defaults to dev when unset.
#BUILD_TARGET=dev

WEB_PORT=
API_PORT=
DB_PORT=
REDIS_PORT=
INDEXER_PORT=

QBITTORRENT_WEBUI_PORT=
QBITTORRENT_TORRENTING_PORT=
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=

DB_HOST=db
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=
DATABASE_URL=

REDIS_HOST=redis

# Host paths for downloads / library, and where they're mounted inside the containers.
HOST_DOWNLOADS_DIR=
HOST_DESTINATIONS_DIR=
CONTAINER_DOWNLOADS_DIR=/media/downloads
CONTAINER_DESTINATIONS_DIR=/media/library
